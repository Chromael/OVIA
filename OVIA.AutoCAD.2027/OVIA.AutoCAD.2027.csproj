<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>OVIA.AutoCAD.2027</AssemblyName>
    <RootNamespace>OVIA.AutoCAD._2027</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoCadApiPackageVersion>26.0.0</AutoCadApiPackageVersion>
    <!-- Autodesk API는 빌드 시 공식 NuGet 참조만 사용하고 고객 배포물에는 복사하지 않습니다. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!--
    지원 AutoCAD 설치 여부와 무관하게 네 버전 플러그인을 항상 빌드합니다.
    CAD 추출 핵심 소스는 OVIA.AutoCAD.Common의 검증된 단일 기준 파일을 링크하여 버전별 fork를 금지합니다.
  -->
  <ItemGroup>
    <Compile Include="..\OVIA.AutoCAD.Common\OviaCommands.cs" Link="OviaCommands.cs" />
    <Compile Include="..\OVIA.AutoCAD.Common\OviaTitleTextCommands.cs" Link="OviaTitleTextCommands.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoCAD.NET" Version="$(AutoCadApiPackageVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="ReportAutoCad2027BuildState" BeforeTargets="CoreCompile">
    <Message Importance="High" Text="OVIA AutoCAD 2027: Autodesk AutoCAD.NET $(AutoCadApiPackageVersion) API로 빌드합니다. AutoCAD 설치 여부와 무관합니다." />
  </Target>

  <!-- Clean 시 과거 stage DLL도 제거하여 실패한 빌드의 오래된 DLL이 Installer에 섞이지 않게 합니다. -->
  <Target Name="CleanOviaAutoCad2027Bundle" AfterTargets="Clean">
    <Delete Files="$(MSBuildThisFileDirectory)..\Installer\AutoCADBundle\Contents\2027\OVIA.AutoCAD.2027.dll" />
  </Target>

  <!-- Release 성공본만 최종 설치 bundle 준비 폴더에 stage합니다. -->
  <Target Name="StageOviaAutoCad2027Bundle" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <OviaBundleStageDir>$(MSBuildThisFileDirectory)..\Installer\AutoCADBundle\Contents\2027</OviaBundleStageDir>
    </PropertyGroup>
    <MakeDir Directories="$(OviaBundleStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(OviaBundleStageDir)\OVIA.AutoCAD.2027.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
